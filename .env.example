# GitHub App credentials (create at https://github.com/settings/apps)
GITHUB_APP_CLIENT_ID=your_client_id_here
GITHUB_APP_CLIENT_SECRET=your_client_secret_here
# The app's slug (the last segment of your app's GitHub URL, e.g. "foldnano").
# When set, the login flow uses the GitHub App installation URL so users are
# prompted to install the app (granting private-repo access) instead of only
# authorising it (which limits them to public repos).
GITHUB_APP_NAME=your_app_slug_here

# Cookie encryption secret (generate a random 32+ char string)
AUTH_COOKIE_SECRET=change_me_to_a_random_secret_string

# Alpha access code(s) gating the landing page, editor, docs, and oligos routes.
# Comma-separate multiple codes to accept any of them.
ALPHA_ACCESS_CODE=change_me_to_a_secret_code
