				{
					"key": "Access-Control-Allow-Origin",
					"value": "*"
				},
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		}
	],
	"redirects": [
		{
			"source": "/docs/plugin-development/foldnano-mini-api",
			"destination": "/docs/plugin-development/foldnano-edit-api",
			"permanent": true
		},
		{
			"source": "/docs/plugin-development/foldnano-mini-api.md",
			"destination": "/docs/plugin-development/foldnano-edit-api.md",
			"permanent": true
		}
	]
}
