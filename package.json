{
	"name": "foldnano",
	"private": true,
	"version": "0.10.0-beta.1",
	"license": "MIT",
	"author": "Xin Shi (KU Leuven)",
	"homepage": "https://fold.xinshilab.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/XinShiLab/foldnano.git"
	},
	"bugs": {
		"url": "https://github.com/XinShiLab/foldnano/issues"
	},
	"type": "module",
	"scripts": {
		"dev": "node scripts/build-plugins.mjs && vite dev",
		"build": "node scripts/build-plugins.mjs && vite build",
		"build:plugins": "node scripts/build-plugins.mjs",
		"gen:pyodide-packages": "node scripts/generate-pyodide-packages.mjs",
		"gen:python-api": "python3 scripts/gen_python_api.py",
		"whats-new:draft": "node scripts/whats-new-draft.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo '' && husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint . && node scripts/docs-check.ts --verify",
		"lint:changed": "sh scripts/lint-changed.sh",
		"lint:branch": "sh scripts/lint-changed.sh main",
		"docs:check": "node scripts/docs-check.ts",
		"docs:verify": "node scripts/docs-check.ts --verify",
		"screenshots:webp": "sh scripts/screenshots-to-webp.sh",
		"test:unit": "vitest",
		"test": "vitest run --changed",
		"test:branch": "vitest run --changed main",
		"test:all": "vitest run",
		"test:python": "cd src/lib/plugin/python && uv run --locked --extra dev pytest -q"
	},
	"devDependencies": {
		"@eslint/compat": "latest",
		"@eslint/js": "^9.39.5",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/nunito-sans": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.49.0",
		"@sveltejs/adapter-auto": "^6.1.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/culori": "^4.0.1",
		"@types/node": "^25.9.8",
		"@types/three": "^0.184.1",
		"@vitest/browser": "^3.2.7",
		"ajv": "^8.20.0",
		"bits-ui": "^2.19.3",
		"clsx": "^2.1.1",
		"esbuild": "^0.25.12",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"fake-indexeddb": "^6.2.5",
		"globals": "^16.5.0",
		"husky": "^9.1.7",
		"jsdom": "^27.4.0",
		"lint-staged": "^17.6.0",
		"mdsvex": "^0.12.8",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"playwright": "^1.63.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"pyodide": "314.0.7",
		"rehype-slug": "^6.0.0",
		"shadcn-svelte": "^1.7.0",
		"shiki": "^4.4.3",
		"svelte": "^5.57.1",
		"svelte-awesome-color-picker": "^4.1.3",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^7.3.6",
		"vite-plugin-devtools-json": "^1.1.0",
		"vitest": "^3.2.7",
		"vitest-browser-svelte": "^1.1.0"
	},
	"dependencies": {
		"@thisux/sveltednd": "^0.4.1",
		"@vercel/analytics": "^2.0.1",
		"@zerodevx/svelte-json-view": "^1.0.11",
		"culori": "^4.0.2",
		"dexie": "^4.4.6",
		"fflate": "^0.8.3",
		"github-slugger": "^2.0.0",
		"konva": "^10.7.0",
		"minisearch": "^7.2.0",
		"prism-code-editor": "^5.4.0",
		"svelte-konva": "^1.0.1",
		"three": "^0.184.0",
		"uuid": "^14.0.2",
		"valibot": "^1.5.0"
	},
	"packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1",
	"engines": {
		"node": "24.x"
	},
	"lint-staged": {
		"*.{ts,svelte,js,svelte.ts,css,html,json,md}": [
			"prettier --write"
		]
	}
}
