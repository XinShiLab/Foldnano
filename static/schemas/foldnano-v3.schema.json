{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Foldnano design file, format version 3",
	"description": "Shape of a Foldnano .fn.json document at formatVersion 3. Field meanings, units and conventions: Foldnano docs, Contributors > File Format.",
	"type": "object",
	"required": ["format", "formatVersion", "id", "parts", "assembly"],
	"additionalProperties": false,
	"properties": {
		"format": { "const": "foldnano" },
		"formatVersion": { "const": 3 },
		"savedWith": {
			"type": "object",
			"required": ["app", "commit"],
			"additionalProperties": false,
			"properties": {
				"app": { "type": "string" },
				"commit": { "type": "string" }
			}
		},
		"id": { "type": "string" },
		"name": {
			"type": "string",
			"description": "Older files only. The design is named after the file, so files are written without it."
		},
		"parts": { "type": "array", "items": { "$ref": "#/$defs/part" } },
		"assembly": { "$ref": "#/$defs/assembly" },
		"exported": {
			"description": "Written by downloads only: when the file was downloaded and a hash of its parts and assembly.",
			"type": "object",
			"required": ["at", "clock", "contentHash"],
			"additionalProperties": false,
			"properties": {
				"at": { "type": "string", "description": "ISO 8601, UTC" },
				"clock": { "enum": ["server", "local"] },
				"contentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
			}
		}
	},
	"$defs": {
		"vec3": {
			"type": "object",
			"required": ["x", "y", "z"],
			"additionalProperties": false,
			"properties": {
				"x": { "type": "number" },
				"y": { "type": "number" },
				"z": { "type": "number" }
			}
		},
		"bpIndex": { "type": "integer", "minimum": 0 },
		"rigidTransform": {
			"description": "Rotate by quaternion [x, y, z, w], then translate by position (nm).",
			"type": "object",
			"required": ["position", "quaternion"],
			"additionalProperties": false,
			"properties": {
				"position": { "$ref": "#/$defs/vec3" },
				"quaternion": {
					"type": "array",
					"minItems": 4,
					"maxItems": 4,
					"items": { "type": "number" }
				}
			}
		},
		"part": {
			"type": "object",
			"required": ["name", "id", "planes", "regions", "virtualHelices", "oligos"],
			"additionalProperties": false,
			"properties": {
				"name": { "type": "string" },
				"id": { "type": "string" },
				"planes": { "type": "array", "items": { "$ref": "#/$defs/plane" } },
				"regions": { "type": "array", "items": { "$ref": "#/$defs/region" } },
				"virtualHelices": { "type": "array", "items": { "$ref": "#/$defs/virtualHelix" } },
				"oligos": { "type": "array", "items": { "$ref": "#/$defs/oligo" } },
				"customModifications": {
					"type": "array",
					"items": { "$ref": "#/$defs/modificationDef" }
				},
				"overlayPlacements": {
					"type": "array",
					"items": { "$ref": "#/$defs/overlayPlacement" }
				},
				"repeatGroups": { "type": "array", "items": { "$ref": "#/$defs/repeatGroup" } },
				"source": { "$ref": "#/$defs/partSource" }
			}
		},
		"partSource": {
			"description": "Present only on a Part linked from another design; the Part's content is a cached copy of it.",
			"type": "object",
			"required": ["partId", "contentHash", "linkedAt"],
			"additionalProperties": false,
			"properties": {
				"repoPath": { "type": "string" },
				"docId": { "type": "string" },
				"partId": { "type": "string" },
				"blobSha": { "type": "string" },
				"contentHash": { "type": "string" },
				"linkedAt": { "type": "string" }
			}
		},
		"assembly": {
			"type": "object",
			"required": ["occurrences"],
			"additionalProperties": false,
			"properties": {
				"occurrences": { "type": "array", "items": { "$ref": "#/$defs/occurrence" } }
			}
		},
		"occurrence": {
			"type": "object",
			"required": ["id", "partId", "name", "transform", "visible"],
			"additionalProperties": false,
			"properties": {
				"id": { "type": "string" },
				"partId": { "type": "string" },
				"name": { "type": "string" },
				"visible": { "type": "boolean" },
				"transform": { "$ref": "#/$defs/rigidTransform" }
			}
		},
		"plane": {
			"type": "object",
			"required": ["id", "name", "origin", "u", "v", "normal"],
			"additionalProperties": false,
			"properties": {
				"id": { "type": "string" },
				"name": { "type": "string" },
				"origin": { "$ref": "#/$defs/vec3" },
				"u": { "$ref": "#/$defs/vec3" },
				"v": { "$ref": "#/$defs/vec3" },
				"normal": { "$ref": "#/$defs/vec3" }
			}
		},
		"region": {
			"type": "object",
			"required": [
				"id",
				"name",
				"kind",
				"planeId",
				"vhOrder",
				"step",
				"turnsPerStep",
				"subStepSize",
				"twistOffset"
			],
			"anyOf": [{ "required": ["maxBase"] }, { "required": ["defaultMaxBase"] }],
			"additionalProperties": false,
			"properties": {
				"id": { "type": "string" },
				"name": { "type": "string" },
				"kind": { "enum": ["HONEYCOMB", "SQUARE", "FREEFORM", "WIREFRAME"] },
				"planeId": { "type": "string" },
				"vhOrder": { "type": "array", "items": { "type": "string" } },
				"step": { "type": "integer", "minimum": 1 },
				"turnsPerStep": { "type": "number", "exclusiveMinimum": 0 },
				"subStepSize": { "type": "integer", "minimum": 1 },
				"twistOffset": { "type": "number" },
				"minBase": {
					"$ref": "#/$defs/bpIndex",
					"description": "Always written; older files may lack it and it defaults to 0."
				},
				"maxBase": { "$ref": "#/$defs/bpIndex" },
				"defaultMaxBase": {
					"$ref": "#/$defs/bpIndex",
					"description": "Legacy name for maxBase; read only when maxBase is absent."
				},
				"referenceGeometry": { "$ref": "#/$defs/referenceGeometry" }
			}
		},
		"referenceGeometry": {
			"type": "object",
			"description": "A wireframe region's input shape, in region-local coordinates. Reference only: helices are the source of truth.",
			"required": ["unit"],
			"additionalProperties": false,
			"properties": {
				"unit": { "const": "nm" },
				"mesh": {
					"type": "object",
					"required": ["vertices", "faces", "edges"],
					"additionalProperties": false,
					"properties": {
						"vertices": {
							"type": "array",
							"items": {
								"type": "array",
								"items": { "type": "number" },
								"minItems": 3,
								"maxItems": 3
							}
						},
						"faces": {
							"type": "array",
							"items": {
								"type": "array",
								"items": { "type": "integer", "minimum": 0 },
								"minItems": 3
							}
						},
						"edges": {
							"type": "array",
							"items": {
								"type": "array",
								"items": { "type": "integer", "minimum": 0 },
								"minItems": 2,
								"maxItems": 2
							}
						}
					}
				}
			}
		},
		"virtualHelix": {
			"type": "object",
			"required": ["index", "listRow", "regionId", "length", "strandSets"],
			"additionalProperties": false,
			"properties": {
				"id": {
					"type": "string",
					"description": "Always written; files from early development may lack it and get a new id on load."
				},
				"index": { "type": "integer", "minimum": 0 },
				"listRow": { "type": "integer" },
				"regionId": { "type": "string" },
				"latticeCoords": {
					"type": "object",
					"required": ["row", "col"],
					"additionalProperties": false,
					"properties": {
						"row": { "type": "integer" },
						"col": { "type": "integer" }
					}
				},
				"localFrame": {
					"type": "object",
					"required": ["origin", "axis", "radial0"],
					"additionalProperties": false,
					"properties": {
						"origin": { "$ref": "#/$defs/vec3" },
						"axis": { "$ref": "#/$defs/vec3" },
						"radial0": { "$ref": "#/$defs/vec3" }
					}
				},
				"length": { "type": "integer", "minimum": 0 },
				"strandSets": {
					"type": "array",
					"minItems": 2,
					"maxItems": 2,
					"items": { "$ref": "#/$defs/strandSet" }
				}
			}
		},
		"strandSet": {
			"type": "object",
			"required": ["strandIndex", "segmentIds"],
			"additionalProperties": false,
			"properties": {
				"strandIndex": { "enum": [0, 1] },
				"segmentIds": { "type": "array", "items": { "type": "string" } }
			}
		},
		"oligo": {
			"type": "object",
			"required": ["id", "segments", "color", "isScaffold", "isSequenceLocked", "name"],
			"additionalProperties": false,
			"properties": {
				"id": { "type": "string" },
				"segments": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/$defs/oligoSegment" }
				},
				"color": { "type": "string" },
				"isScaffold": { "type": "boolean" },
				"isSequenceLocked": { "type": "boolean" },
				"name": { "type": "string" },
				"repeatGroupId": { "type": "string" },
				"mirrorOf": {
					"type": "object",
					"required": ["groupId", "instanceId", "sourceOligoId", "structure"],
					"additionalProperties": false,
					"properties": {
						"groupId": { "type": "string" },
						"instanceId": { "type": "string" },
						"sourceOligoId": { "type": "string" },
						"structure": { "type": "string" }
					}
				}
			}
		},
		"oligoSegment": {
			"type": "object",
			"required": ["id", "inVirtualHelixIndex", "fivePrime", "threePrime"],
			"additionalProperties": false,
			"properties": {
				"id": { "type": "string" },
				"inVirtualHelixIndex": { "type": "integer", "minimum": 0 },
				"fivePrime": { "$ref": "#/$defs/segmentEnd" },
				"threePrime": { "$ref": "#/$defs/segmentEnd" },
				"sequence": { "type": "string" },
				"slots": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["bpIndex", "seq"],
						"additionalProperties": false,
						"properties": {
							"bpIndex": { "$ref": "#/$defs/bpIndex" },
							"seq": { "type": "string" }
						}
					}
				}
			}
		},
		"segmentEnd": {
			"type": "object",
			"required": ["segmentId", "isThreePrime", "index", "connectedSegmentId"],
			"additionalProperties": false,
			"properties": {
				"segmentId": { "type": "string" },
				"isThreePrime": { "type": "boolean" },
				"index": { "$ref": "#/$defs/bpIndex" },
				"connectedSegmentId": { "type": ["string", "null"] },
				"modification": { "type": ["string", "null"] },
				"isConstrained": {
					"type": "boolean",
					"description": "Derived from the design; written for reference and recomputed on load."
				}
			}
		},
		"modificationDef": {
			"type": "object",
			"required": ["name"],
			"additionalProperties": false,
			"properties": {
				"name": { "type": "string" },
				"color": { "type": "string" },
				"symbol": {
					"type": "string",
					"description": "Legacy; files saved before modifications had colors. Ignored on load."
				}
			}
		},
		"overlayPlacement": {
			"type": "object",
			"required": ["id", "transform"],
			"additionalProperties": false,
			"properties": {
				"id": { "type": "string" },
				"sourceKey": { "type": "string" },
				"transform": { "$ref": "#/$defs/rigidTransform" }
			}
		},
		"repeatGroup": {
			"type": "object",
			"required": ["id", "name", "instances"],
			"additionalProperties": false,
			"properties": {
				"id": { "type": "string" },
				"name": { "type": "string" },
				"instances": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["id", "bpOffset"],
						"additionalProperties": false,
						"properties": {
							"id": { "type": "string" },
							"bpOffset": { "type": "integer" },
							"vhMap": {
								"type": "object",
								"additionalProperties": { "type": "string" }
							}
						}
					}
				}
			}
		}
	}
}
